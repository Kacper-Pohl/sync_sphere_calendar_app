# Database (inside Docker containers use hostname `db`, not `localhost`)
DATABASE_URL=postgresql://devuser:devpassword@db:5432/calendar_db?schema=public

# Google OAuth 2.0 — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT signing secret (use a long random string in production)
JWT_SECRET=

# Frontend URL (OAuth redirect target)
FRONTEND_URL=http://localhost:3000

# API URL exposed to the browser
NEXT_PUBLIC_API_URL=http://localhost:3001
